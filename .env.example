GOOGLE_API_KEY=
OPENAI_API_KEY=

LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini

# Used only by eval/run_eval.py's LLM-as-judge, never by the app itself —
# see the module docstring for why the judge runs on a different provider.
# GROQ_MODEL is optional; defaults to llama-3.3-70b-versatile if unset.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

DB_HOST=localhost
DB_PORT=5432
DB_NAME=enterprise_rag

DB_USER=raguser
DB_PASSWORD=ragpass

DB_READONLY_USER=readonly_user
DB_READONLY_PASSWORD=readonly_password

CSV_DIR=data/csv
